# ── WhatsApp Business Cloud API ─────────────────────────────────────────
# Meta Developer Console > App > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
# Webhook doğrulama için kendin belirle (istediğin string)
WHATSAPP_VERIFY_TOKEN=my_secret_verify_token_123

# ── Anthropic Claude API ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Şirket Bilgileri ──────────────────────────────────────────────────────
COMPANY_NAME=Şirket Adı
AGENT_NAME=Asistan

# ── Ürün Kataloğu ────────────────────────────────────────────────────────
# data/ klasörüne koyduğun Excel/CSV dosyasının adı
PRODUCT_CATALOG_FILE=data/products.xlsx

# ── İnsan Devreye Alma ───────────────────────────────────────────────────
# AI'ın cevaplayamayacağı durumlarda bildirim gönderilecek WhatsApp numarası
# Uluslararası format, + olmadan: 905551234567
ADMIN_PHONE=905551234567

# ── Uygulama ─────────────────────────────────────────────────────────────
# Üretimde değiştir
APP_SECRET=change_me_in_production
MAX_CONVERSATION_TURNS=50
